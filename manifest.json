{
  "manifest_version": 3,
  "name": "小红书笔记收集器",
  "version": "1.0.0",
  "description": "一键保存小红书笔记到飞书多维表格",
  
  "permissions": [
    "activeTab",
    "storage"
  ],
  
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://open.feishu.cn/*"
  ],
  
  "content_scripts": [
    {
      "matches": ["https://www.xiaohongshu.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "小红书笔记收集器"
  },
  
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}